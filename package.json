{
  "name": "food-entry-prototype",
  "version": "0.2.0",
  "private": true,
  "description": "PSP kursinis darbas: maisto sekimo sistemos valgio įrašo sudarymo modulis (II etapas, prototipas)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "phone": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts --lan",
    "dev":"node --disable-warning=ExperimentalWarning --watch --import tsx src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "reset-db": "node --disable-warning=ExperimentalWarning --import tsx src/infra/reset-db.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@zxing/library": "^0.21.3",
    "fastify": "^5.2.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
