# Nukopijuokite į .env ir įrašykite savo reikšmes. Tikrų raktų į repozitoriją nedėkite.

# Serverio prievadas
PORT=3000

# SQLite failas (sukuriamas automatiškai su pavyzdiniais duomenimis)
DB_PATH=data/food.db

# Google Gemini API raktas: https://aistudio.google.com/apikey
# Be rakto viskas veikia, tik AI įvertinimas grąžina 503 „AI estimates are off“.
GEMINI_API_KEY=

# Modeliai bandomi iš eilės (R4): kiekvienam 30 s, nepavykus – kitas.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_ATTEMPT_TIMEOUT_MS=30000
